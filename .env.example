# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
OPENAI_API_KEY=
AZURE_SUBSCRIPTION_ID=
AGENT_MODEL=gpt-4o-mini

# Optional: Langfuse tracing (https://cloud.langfuse.com, free tier). Leave blank to
# run with no tracing - agents/tracing.py makes this strictly opt-in.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
